{
  "name": "@argent/x-sessions",
  "version": "9.0.4",
  "private": false,
  "description": "Manage sessions for Argent X wallets",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "starknet",
    "starkware",
    "sessions",
    "session",
    "argent",
    "wallet",
    "dapp"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/sessions.js",
      "require": "./dist/sessions.umd.cjs"
    }
  },
  "main": "./dist/sessions.umd.cjs",
  "module": "./dist/sessions.js",
  "types": "./dist/sessions.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argentlabs/x-sessions.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "dev": "vite build --watch",
    "setup": "vite build",
    "build": "vite build",
    "prepare": "husky"
  },
  "bugs": {
    "url": "https://github.com/argentlabs/x-sessions/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@semantic-release/git": "10.0.1",
    "@starknet-io/types-js": "0.9.2",
    "@types/minimalistic-assert": "1.0.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@vitest/browser": "1.3.1",
    "@vitest/coverage-c8": "0.33.0",
    "@vitest/coverage-v8": "1.3.1",
    "@vitest/ui": "1.2.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "get-starknet": "4.0.0-next.2",
    "happy-dom": "13.10.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "msw": "2.12.9",
    "prettier": "3.8.1",
    "semantic-release": "25.0.2",
    "vite": "5.4.21",
    "vite-plugin-dts": "3.9.1",
    "vitest": "1.3.1"
  },
  "dependencies": {
    "minimalistic-assert": "1.0.1"
  },
  "peerDependencies": {
    "starknet": "9.1.1"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{ts,tsx}": "eslint --cache --fix"
  }
}
